---
import { type CollectionEntry, getCollection, render } from "astro:content";
import { SITE_ORIGIN } from "@constants/site";
import { profileConfig } from "../../config";
import "../../styles/markdown.css";
import "../../styles/expressive-code.css";
import type { GetStaticPaths } from "astro";
import Twikoo from "../../components/post/Twikoo";
import I18nKey from "../../i18n/i18nKey";
import {
	isFallbackPath,
	localizePath,
	resolveLocale,
} from "../../i18n/locales";
import { i18n } from "../../i18n/translation";
import Layout from "../../layouts/Layout.astro";
import { formatDate, formatDateTime } from "../../utils/date-utils";
import { stripMarkdown, truncate } from "../../utils/strip-markdown";

export const getStaticPaths = (async () => {
	const entries = await getCollection("essays");
	return entries
		.filter((entry) => !entry.filePath?.endsWith(".en.md"))
		.sort(
			(a, b) =>
				new Date(b.data.published).getTime() -
				new Date(a.data.published).getTime(),
		)
		.map((entry) => ({
			params: { slug: entry.id },
			props: { entry },
		}));
}) satisfies GetStaticPaths;

interface Props {
	entry: CollectionEntry<"essays">;
}

const { entry: baseEntry } = Astro.props;
const locale = resolveLocale(Astro.currentLocale, Astro.url.pathname);
const slug = Astro.params.slug as string;
const localized =
	locale === "en"
		? (await getCollection("essays")).find((essay) =>
				essay.filePath?.endsWith(`${slug}.en.md`),
			)
		: undefined;
const entry = localized ?? baseEntry;
const t = (key: I18nKey) => i18n(key, locale);
const { Content } = await render(entry);
const essayTitle = entry.data.title?.trim() || t(I18nKey.navEssays);
const pageTitle = essayTitle;
const essayHref = localizePath(`/essays/${slug}/`, locale);
const isFallback = !localized && isFallbackPath(Astro.url.pathname, locale);
const publishedLabel = (
	entry.data.publishedHasTime
		? formatDateTime(entry.data.published)
		: formatDate(entry.data.published)
).replace(/\//g, ".");
const metaDescription =
	truncate(stripMarkdown(entry.body ?? ""), 120) || essayTitle;
---

<Layout title={pageTitle} description={metaDescription} translated={Boolean(localized)}>

		<div class="relative w-full max-w-[840px] bg-page paper-texture shadow-2xl px-6 md:px-16 py-10 overflow-hidden">
			{/* Back link */}
			<div class="pb-6 border-b border-border/20 flex items-center gap-3">
				<a href={localizePath("/essays/", locale)} class="text-secondary hover:text-primary transition-colors">
					<svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
						<path stroke-linecap="round" stroke-linejoin="round" d="M19 12H5m7-7-7 7 7 7"/>
					</svg>
				</a>
				<h1 class="font-heading text-[15px] font-bold text-primary">{t(I18nKey.navEssays)}</h1>
			</div>

			{/* Article */}
			<article data-pagefind-body={isFallback ? undefined : true} class="py-6 border-b border-border/20">
				<div class="flex gap-3">
					<div class="w-10 h-10 rounded-full bg-hint/20 border border-border/30 overflow-hidden flex-shrink-0 mt-0.5">
						<div class="w-full h-full rounded-full bg-cover bg-center" style={`background-image:url(${profileConfig.avatar});width:100%;height:100%;border-radius:9999px`}></div>
					</div>
					<div class="flex-1 min-w-0">
						<div class="flex items-baseline gap-1.5 mb-0.5">
							<span class="font-display text-[15px] font-bold text-primary leading-tight">{profileConfig.name}</span>
							<span class="font-deco text-[13px] text-secondary shrink-0">·</span>
							<span class="font-deco text-[13px] text-secondary shrink-0 whitespace-nowrap">{publishedLabel}</span>
						</div>

						<div class="essay-content font-cn text-[15px] leading-relaxed text-primary whitespace-pre-wrap break-words">
							<Content />
						</div>

						<div class="flex items-center gap-8 mt-3 text-secondary">
							<a href="#comments" aria-label={t(I18nKey.commentsAria)} class="flex h-9 w-9 items-center justify-center text-secondary hover:text-accent transition-colors">
								<svg class="w-[18px] h-[18px]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 20.25c4.97 0 9-3.694 9-8.25s-4.03-8.25-9-8.25S3 7.444 3 12c0 2.104.859 4.023 2.273 5.48.432.447.74 1.04.586 1.641a4.483 4.483 0 0 1-.923 1.785A5.969 5.969 0 0 0 6 21c1.282 0 2.47-.402 3.445-1.087.81.22 1.668.337 2.555.337Z"/></svg>
							</a>
							<button class="share-btn flex h-9 w-9 items-center justify-center text-secondary hover:text-accent transition-colors" aria-label={t(I18nKey.share)} data-url={`${SITE_ORIGIN}${essayHref}`}>
								<svg class="w-[18px] h-[18px]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M7.217 10.907a2.25 2.25 0 1 0 0 2.186m0-2.186c.18.324.283.696.283 1.093s-.103.77-.283 1.093m0-2.186 9.566-5.314m-9.566 7.5 9.566 5.314m0 0a2.25 2.25 0 1 0 3.935 2.186 2.25 2.25 0 0 0-3.935-2.186Zm0-12.814a2.25 2.25 0 1 0 3.933-2.185 2.25 2.25 0 0 0-3.933 2.185Z"/></svg>
							</button>
						</div>

					</div>
				</div>
			</article>

			{/* Comments */}
			<div id="comments" class="py-6">
				<Twikoo client:visible lang={locale} />
			</div>
		</div>

</Layout>

<script>
	import "../../scripts/share-btn.ts";
</script>
