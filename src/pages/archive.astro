---
import ArchiveHeader from "@components/pages/ArchiveHeader.astro";
import ArchivePanel from "@components/pages/ArchivePanel.astro";
import I18nKey from "../i18n/i18nKey";
import { resolveLocale } from "../i18n/locales";
import { getSiteTitle } from "../i18n/site";
import { i18n } from "../i18n/translation";
import Layout from "../layouts/Layout.astro";
import { getSortedPosts } from "../utils/content-utils";

const locale = resolveLocale(Astro.currentLocale, Astro.url.pathname);
const t = (key: I18nKey) => i18n(key, locale);
const sortedPosts = await getSortedPosts();

const archiveLabel = t(I18nKey.archive);
const pageTitle = `${archiveLabel} - ${getSiteTitle(locale)}`;
const metaDescription = `${getSiteTitle(locale)} ${archiveLabel} - ${sortedPosts.length} records`;
---

<Layout title={pageTitle} description={metaDescription}>

		<ArchiveHeader
			title={archiveLabel}
			count={sortedPosts.length}
			variant="dark"
			lang={locale}
		/>

		<ArchivePanel sortedPosts={sortedPosts} lang={locale} />
</Layout>
