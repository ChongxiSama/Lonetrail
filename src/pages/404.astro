---
import Button from "../components/ui/Button";
import { StripeFooter } from "../components/ui/StripeFooter.tsx";
import I18nKey from "../i18n/i18nKey";
import { localizePath, resolveLocale } from "../i18n/locales";
import { i18n } from "../i18n/translation";
import Layout from "../layouts/Layout.astro";
import { getSortedPosts } from "../utils/content-utils";

const locale = resolveLocale(Astro.currentLocale, Astro.url.pathname);
const t = (key: I18nKey) => i18n(key, locale);
const allPosts = await getSortedPosts(locale);
const picks = [0, 4, 11]
	.map((i) => allPosts[i % allPosts.length])
	.filter(Boolean);
---
<Layout title={`404 - ${t(I18nKey.notFound)}`} noindex>
    <div class="w-full max-w-[840px]" style="filter: drop-shadow(0 8px 30px rgba(0,0,0,0.3));">
        <header class="relative px-6 md:px-16 py-10 md:py-12 overflow-hidden">
            <img src="/images/backend.webp" alt="" class="absolute inset-0 w-full h-full object-cover z-0" loading="eager" decoding="async" />
            <div class="absolute inset-0 bg-black/60 z-[1]"></div>
            <div class="absolute -top-1 -left-1 w-3 h-3 border-t border-l border-on-hero/40 z-20"></div>
            <div class="absolute -top-1 -right-1 w-3 h-3 border-t border-r border-on-hero/40 z-20"></div>
            <div class="absolute -bottom-1 -left-1 w-3 h-3 border-b border-l border-on-hero/40 z-20"></div>
            <div class="absolute -bottom-1 -right-1 w-3 h-3 border-b border-r border-on-hero/40 z-20"></div>
            <div class="absolute inset-0 paper-texture opacity-30 pointer-events-none z-[2]"></div>

            <div class="relative z-10 flex justify-between items-center mb-10 md:mb-12">
                <div class="flex items-center gap-3">
                    <div class="w-[3px] h-[10px] bg-accent"></div>
                    <span class="font-deco text-[10px] md:text-[11px] font-bold tracking-[0.2em] uppercase text-on-hero/70">
                        System // Error_Report
                    </span>
                </div>
                <div class="hidden sm:block">
                    <span class="font-deco text-[10px] md:text-[11px] uppercase tracking-widest text-on-hero/40">
                        Signal_Lost // Connectivity_Fail
                    </span>
                </div>
            </div>

            <div class="relative z-10">
                <div class="absolute -top-4 md:-top-10 -right-8 md:-right-20 pointer-events-none select-none">
                    <span class="font-deco text-[32px] md:text-[120px] text-on-hero opacity-[0.03] leading-none uppercase whitespace-nowrap">
                        INVALID
                    </span>
                </div>

                <h1 class="font-heading text-[64px] md:text-[120px] leading-none text-on-hero font-black mb-4">404</h1>
                <h2 class="font-heading text-[28px] md:text-[40px] tracking-tight text-on-hero font-black mb-8">{t(I18nKey.notFound)}</h2>

                <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 pt-6 border-t border-on-hero/10">
                    <p class="font-cn text-[11px] text-on-hero/40 tracking-[0.2em]">
                        Ref_ID: PTL-ERR-DATA-INVALID<br />Institutional Registry Access Denied
                    </p>
                </div>
            </div>

            <StripeFooter />
        </header>
    </div>

    <main class="relative w-full max-w-[840px] bg-page paper-texture shadow-2xl px-6 md:px-16 py-10 md:py-12 overflow-hidden">
        <div class="space-y-6">
            <div class="flex items-center gap-3">
                <h2 class="text-[11px] font-black text-secondary uppercase tracking-[0.3em]">01 // Fault_Summary</h2>
                <div class="flex-1 h-[1px] bg-border"></div>
            </div>
            <p class="font-cn text-[16px] leading-[1.8] text-primary font-medium max-w-2xl text-justify">
                {t(I18nKey.notFoundDesc)}
            </p>
        </div>

        <div class="flex pt-10">
            <Button
                as="a"
                href={localizePath("/", locale)}
                variant="unstyled"
                className="group flex-1 md:flex-none md:min-w-[320px] bg-accent text-on-hero dark:text-[#1A1814] text-[11px] font-bold uppercase tracking-[0.2em] py-5 text-center transition-all flex items-center justify-center gap-3 animate-breathing-glow"
            >
                <span class="text-lg leading-none">←</span>
                {t(I18nKey.returnHome)}
            </Button>
        </div>

        <div class="mt-12">
            <div class="flex items-center gap-3 mb-4">
                <h2 class="text-[11px] font-black text-secondary uppercase tracking-[0.3em]">02 // Suggest_Entries</h2>
                <div class="flex-1 h-[1px] bg-border"></div>
            </div>
            <div class="divide-y divide-border/20">
                {picks.map((post) => (
                    <a
                        href={localizePath(`/posts/${post.slug}/`, locale)}
                        class="group flex items-center justify-between gap-4 py-3"
                    >
                        <span class="font-cn text-[14px] text-primary leading-snug group-hover:text-accent transition-colors">
                            {post.data.title}
                        </span>
                        <span class="font-deco text-[11px] text-secondary shrink-0 group-hover:translate-x-1 transition-transform">
                            &rarr;
                        </span>
                    </a>
                ))}
            </div>
            <p class="mt-4 font-cn text-[11px] text-hint">
                {t(I18nKey.searchShortcutHint)} <kbd class="font-mono">⌘K</kbd>
            </p>
        </div>
    </main>
</Layout>
