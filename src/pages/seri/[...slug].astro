---
import { getCollection, render } from "astro:content";
import ArchiveHeader from "@components/pages/ArchiveHeader.astro";
import I18nKey from "../../i18n/i18nKey";
import { localizePath, resolveLocale } from "../../i18n/locales";
import { i18n } from "../../i18n/translation";
import Layout from "../../layouts/Layout.astro";
import { getSortedPosts } from "../../utils/content-utils";
import { formatDate } from "../../utils/date-utils";
import { stripMarkdown, truncate } from "../../utils/strip-markdown";

export async function getStaticPaths() {
	const series = await getCollection("seri");
	return series
		.filter((s) => !s.filePath?.endsWith(".en.md"))
		.map((s) => ({ params: { slug: s.id } }));
}

const locale = resolveLocale(Astro.currentLocale, Astro.url.pathname);
const slug = Astro.params.slug as string;
const series = await getCollection("seri");
const localized =
	locale === "en"
		? series.find((s) => s.filePath?.endsWith(`/${slug}.en.md`))
		: undefined;
const seri = (localized ?? series.find((s) => s.id === slug))!;
const t = (key: I18nKey) => i18n(key, locale);
const { title, subtitle, description, filter, sortOrder = "desc" } = seri.data;
const { Content } = await render(seri);

const allPosts = await getSortedPosts(locale);
const filteredPosts = allPosts.filter((post) => {
	if (!filter) return false;
	if (filter.tag && post.data.tags?.includes(filter.tag)) return true;
	if (filter.category && post.data.category === filter.category) return true;
	return false;
});

const chapters = [...filteredPosts].sort((a, b) =>
	sortOrder === "asc"
		? a.data.published.getTime() - b.data.published.getTime()
		: b.data.published.getTime() - a.data.published.getTime(),
);

const pageTitle = `${title} - ${subtitle || t(I18nKey.series)}`;

const metaDescription =
	description?.trim() || truncate(stripMarkdown(seri.body ?? ""), 140);

const seriesSpan = (() => {
	if (filteredPosts.length === 0) return "";
	const times = filteredPosts.map((post) => post.data.published.getTime());
	const first = formatDate(new Date(Math.min(...times)))
		.slice(0, 7)
		.replace("/", ".");
	const last = formatDate(new Date(Math.max(...times)))
		.slice(0, 7)
		.replace("/", ".");
	return `${first} — ${last}`;
})();

const seriesEntities = filteredPosts.map((post) => ({
	title: post.data.title,
	url: new URL(`/posts/${post.slug}/`, Astro.site).toString(),
}));
---

<Layout
	title={pageTitle}
	description={metaDescription}
	banner={seri.data.image}
	entities={seriesEntities}
>

		<ArchiveHeader
			title={title}
			count={filteredPosts.length}
			variant="dark"
			compact
			lang={locale}
		/>

		<div class="relative w-full max-w-[840px] px-6 md:px-10 pt-5 pb-1">
			<div class="flex items-baseline justify-between gap-3 mb-2">
				<span class="font-deco text-[9px] text-hint uppercase tracking-[0.3em]">
					Series_{slug.toUpperCase()}
				</span>
				{seriesSpan && (
					<span class="font-date text-[10px] text-hint shrink-0">{seriesSpan}</span>
				)}
			</div>
			<div class="flex flex-wrap items-center gap-x-3 gap-y-1 font-deco text-[9px] text-hint uppercase tracking-[0.2em]">
				<span>{filteredPosts.length} {t(I18nKey.postsCount)}</span>
				<span class="w-1 h-1 rounded-full bg-hover/60"></span>
				<span>{subtitle || t(I18nKey.series)}</span>
			</div>
		</div>

		<div class="relative w-full max-w-[840px] px-6 md:px-10 py-6">
			<article class="prose custom-md max-w-none font-cn text-primary/80">
				<Content />
			</article>
		</div>

		<div class="relative w-full max-w-[840px] px-6 md:px-10 pb-12">
			<div class="flex items-center gap-3 mb-5">
				<div class="w-[3px] h-[10px] bg-accent"></div>
				<span class="font-heading text-[13px] font-bold uppercase tracking-tight text-primary">
					{t(I18nKey.chapters)}
				</span>
				<span class="font-deco text-[9px] text-hint uppercase tracking-[0.2em]">
					Table of Contents
				</span>
				<div class="flex-1 h-px bg-hover/40"></div>
			</div>

			<ol class="relative ml-2 border-l-2 border-accent/25">
				{chapters.map((post, index) => (
					<li>
						<a
							href={localizePath(`/posts/${post.slug}/`, locale)}
							class="group relative flex items-center gap-3 border-b border-border/20 py-3 pl-5 transition-colors hover:bg-card/40"
						>
							<span class="absolute left-0 top-1/2 h-2 w-2 -translate-x-1/2 -translate-y-1/2 rounded-full bg-accent/50 ring-2 ring-page transition-colors group-hover:bg-accent" />
							<span class="font-date text-[10px] text-accent/70 w-6 shrink-0">
								{String(index + 1).padStart(2, "0")}
							</span>
							<span class="font-date text-[11px] text-secondary w-11 shrink-0">
								{formatDate(post.data.published).slice(5).replace("/", ".")}
							</span>
							<h3 class="flex-1 min-w-0 truncate font-heading text-[15px] font-bold text-primary transition-colors group-hover:text-accent">
								{post.data.title}
							</h3>
							<span class="font-deco text-sm text-secondary shrink-0 transition-colors group-hover:text-accent">
								→
							</span>
						</a>
					</li>
				))}
			</ol>

			{chapters.length === 0 && (
				<p class="py-10 text-center font-deco text-[11px] text-secondary italic">
					{t(I18nKey.noChapters)}
				</p>
			)}
		</div>
</Layout>
