---
import SubscribePage from "@components/pages/SubscribePage";
import { SITE_URL } from "@constants/site";
import Layout from "@layouts/Layout.astro";
import { buildAtomFeed } from "@utils/feed-builder";
import I18nKey from "../i18n/i18nKey";
import { resolveLocale } from "../i18n/locales";
import { getSiteTitle } from "../i18n/site";
import { i18n } from "../i18n/translation";

const locale = resolveLocale(Astro.currentLocale, Astro.url.pathname);
const subscribeLabel = i18n(I18nKey.subscribe, locale);
const pageTitle = `${subscribeLabel} - ${getSiteTitle(locale)}`;
const metaDescription = `${getSiteTitle(locale)} - ${subscribeLabel}`;
const feed = await buildAtomFeed(Astro.site?.toString() || SITE_URL, locale);
const feedLines = feed.split("\n");
---

<Layout title={pageTitle} description={metaDescription}>
		<SubscribePage
			client:visible
			totalLines={feedLines.length}
			previewLines={feedLines.slice(0, 120)}
			lang={locale}
		/>
</Layout>
