---
import Umami from "../components/umami.astro";
import { getMetaDescription, getPageTitle } from "../seo/meta";
import { generateJsonLd } from "../seo/schema";
import "../styles/tokens.css";
import "../styles/swup-slide.css";
import "../styles/lonetrail.css";
import "../styles/fonts.css";
import "../styles/twikoo.css";
import { Font } from "astro:assets";
import Footer from "@components/layout/Footer.astro";
import MobileNav from "@components/layout/MobileNav.astro";
import SideDrawer from "@components/layout/SideDrawer.astro";
import Lightbox from "@components/ui/Lightbox.astro";
import { SITE_URL } from "@constants/site";
import I18nKey from "@i18n/i18nKey";
import { i18n } from "@i18n/translation";
import {
	featureConfig,
	navBarConfig,
	profileConfig,
	siteConfig,
	siteMeta,
} from "@/config";
import { SearchPanel } from "../components/ui/SearchPanel.tsx";
import {
	BANNER_HEIGHT,
	BANNER_HEIGHT_EXTEND,
	MAIN_PANEL_OVERLAPS_BANNER_HEIGHT,
	PAGE_WIDTH,
} from "../constants/constants";
import { defaultFavicons } from "../constants/icon";
import { resolveNavLink } from "../constants/link-presets";
import {
	DEFAULT_LOCALE,
	getSwitchLocalePath,
	hasLocaleVersion,
	isFallbackPath,
	LOCALE_META,
	type Locale,
	localizePath,
	resolveLocale,
	stripLocaleFromPath,
} from "../i18n/locales";
import { getSiteTitle } from "../i18n/site";
import { type Favicon, type NavBarLink } from "../types/config";
import { isHomePath, makeUrl } from "../utils/url-utils";

interface Props {
	title?: string;
	banner?: string;
	description?: string;
	lang?: string;
	setOGTypeArticle?: boolean;
	category?: string;
	entities?: Record<string, unknown>[];
	citations?: string[];
	published?: Date;
	updated?: Date;
	tags?: string[];
	wordCount?: number;
	hideFooter?: boolean;
	noindex?: boolean;
	/** A real translated page, so i18n fallback rules must not apply. */
	translated?: boolean;
}
let {
	title,
	banner,
	description,
	lang,
	setOGTypeArticle,
	category,
	entities,
	citations,
	published,
	updated,
	tags,
	wordCount,
	hideFooter,
	noindex = false,
	translated = false,
} = Astro.props;
const locale = resolveLocale(Astro.currentLocale, Astro.url.pathname);
const localeMeta = LOCALE_META[locale];
const links: NavBarLink[] = navBarConfig.links.map((item) => {
	const link = resolveNavLink(item, locale);
	if (link.external) return link;
	return { ...link, url: localizePath(link.url, locale) };
});
const trailingSlashNormalizer = /\/?$/;
const currentPath = Astro.url.pathname.replace(trailingSlashNormalizer, "/");
const barePath = stripLocaleFromPath(currentPath).replace(
	trailingSlashNormalizer,
	"/",
);
const isHomePage = barePath === "/" || isHomePath(barePath);
const pageTitle = getPageTitle(title, locale);
const metaDescription = getMetaDescription(description, locale);
const siteLang = lang || localeMeta.htmlLang;
const postsBasePath = makeUrl("/posts/").replace(trailingSlashNormalizer, "/");
const isPostPage = barePath.startsWith(postsBasePath);

// A route rendered at `/en/...` without a dedicated English page is a
// fallback of the Chinese original: keep it out of the index and point the
// canonical back to zh to avoid duplicate content.
const isFallback = !translated && isFallbackPath(Astro.url.pathname, locale);
const hasLocalizedPair = translated || hasLocaleVersion(Astro.url.pathname);
const localizedHref = (target: Locale) => localizePath(currentPath, target);
const absoluteHref = (target: Locale) =>
	new URL(localizedHref(target), Astro.site).toString();
let canonicalURL = new URL(
	isFallback ? localizedHref(DEFAULT_LOCALE) : localizedHref(locale),
	Astro.site,
).toString();
if (!canonicalURL.endsWith("/")) {
	const lastPart = canonicalURL.split("/").pop();
	if (lastPart && !lastPart.includes(".")) {
		canonicalURL += "/";
	}
}
const switchLocale = localeMeta.alternate;
const switchHref = getSwitchLocalePath(Astro.url.pathname, switchLocale);
const shouldNoindex = noindex || isFallback;
const favicons: Favicon[] =
	siteConfig.favicon.length > 0 ? siteConfig.favicon : defaultFavicons;
let ogImage = new URL(banner || siteMeta.ogImage, Astro.site).toString();
const ogType = setOGTypeArticle ? "article" : "website";
const siteName = getSiteTitle(locale);
const jsonLd = generateJsonLd({
	siteUrl: Astro.site?.toString() || SITE_URL,
	canonicalURL,
	title,
	metaDescription,
	siteLang,
	isHomePage,
	isPostPage,
	published,
	updated,
	ogImage,
	tags,
	category,
	wordCount,
	entities,
	citations,
	currentPath,
});
const breadcrumbItems: {
	"@type": string;
	position: number;
	name: string;
	item: string | URL | undefined;
}[] = [
	{
		"@type": "ListItem",
		position: 1,
		name: i18n(I18nKey.home, locale),
		item: Astro.site,
	},
];
if (isPostPage) {
	if (category) {
		breadcrumbItems.push({
			"@type": "ListItem",
			position: 2,
			name: category,
			item: new URL(
				localizePath(`/categories/${category}/`, DEFAULT_LOCALE),
				Astro.site,
			).toString(),
		});
		breadcrumbItems.push({
			"@type": "ListItem",
			position: 3,
			name: title || "Post",
			item: canonicalURL,
		});
	} else {
		breadcrumbItems.push({
			"@type": "ListItem",
			position: 2,
			name: title || "Post",
			item: canonicalURL,
		});
	}
} else if (!isHomePage) {
	breadcrumbItems.push({
		"@type": "ListItem",
		position: 2,
		name: title || "Page",
		item: canonicalURL,
	});
}
(jsonLd["@graph"] as Record<string, unknown>[]).push({
	"@type": "BreadcrumbList",
	"@id": `${canonicalURL}#breadcrumb`,
	itemListElement: breadcrumbItems,
});
---
<!DOCTYPE html>
<html
	lang={siteLang}
	class="bg-[var(--page-bg)] text-[14px] md:text-[15px] 2xl:text-[16px]"
	data-en-href={hasLocalizedPair && locale === DEFAULT_LOCALE ? localizedHref("en") : undefined}
>
	<head>
		<script is:inline>
			(() => {
				const root = document.documentElement;
				const stored = (() => {
					try {
						return localStorage.getItem('theme');
					} catch {
						return null;
					}
				})();
				const dark =
					stored === 'dark' ||
					(stored !== 'light' &&
						window.matchMedia('(prefers-color-scheme: dark)').matches);
				root.classList.toggle('dark', dark);
			})();
		</script>
		<script is:inline>
			(() => {
				const enHref = document.documentElement.dataset.enHref;
				if (!enHref) return;
				if (
					location.pathname === '/en' ||
					location.pathname.startsWith('/en/')
				)
					return;
				let pref = null;
				try {
					pref = localStorage.getItem('lang');
				} catch {
					pref = null;
				}
				const browserEn = (navigator.language || '')
					.toLowerCase()
					.startsWith('en');
				if (pref === 'en' || (!pref && browserEn)) {
					location.replace(enHref);
				}
			})();
		</script>
		<script is:inline>
			document.addEventListener('click', (event) => {
				const el = event.target.closest
					? event.target.closest('[data-lang-switch]')
					: null;
				if (!el) return;
				try {
					localStorage.setItem('lang', el.getAttribute('data-lang-switch'));
				} catch {
					/* storage unavailable */
				}
			});
		</script>
		<title>{pageTitle}</title>
		<Font cssVariable="--font-mono-var" />
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
		<meta name="referrer" content="no-referrer-when-downgrade" />
		<meta name="description" content={metaDescription} />
		<meta name="generator" content={Astro.generator} />
		<meta name="theme-color" content="#D4621A" />
		<meta name="author" content={profileConfig.name} />
		<meta name="robots" content={shouldNoindex ? "noindex, nofollow" : "index, follow"} />
		<link rel="canonical" href={canonicalURL} />
		{hasLocalizedPair && !isFallback ? (
			<>
				<link rel="alternate" hreflang="zh-CN" href={absoluteHref("zh")} />
				<link rel="alternate" hreflang="en" href={absoluteHref("en")} />
				<link rel="alternate" hreflang="x-default" href={absoluteHref("zh")} />
			</>
		) : isFallback ? null : (
			<link rel="alternate" hreflang={siteLang} href={canonicalURL} />
		)}
		<link rel="alternate" type="application/rss+xml" title={`${siteName} - RSS`} href={locale === "en" ? "/en/rss.xml" : "/rss.xml"} />
		<link rel="alternate" type="application/atom+xml" title={`${siteName} - Atom`} href={locale === "en" ? "/en/atom.xml" : "/atom.xml"} />
		<link rel="manifest" href="/manifest.json" />
		<meta property="og:type" content={ogType} />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={metaDescription} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:site_name" content={siteName} />
		<meta property="og:locale" content={localeMeta.ogLocale} />
		{hasLocalizedPair && !isFallback && (
			<meta property="og:locale:alternate" content={LOCALE_META[switchLocale].ogLocale} />
		)}
		{isPostPage && published && <meta property="article:published_time" content={published.toISOString()} />}
		{isPostPage && updated && <meta property="article:modified_time" content={updated.toISOString()} />}
		{isPostPage && category && <meta property="article:section" content={category} />}
		{isPostPage && tags && tags.map(tag => <meta property="article:tag" content={tag} />)}
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:url" content={canonicalURL} />
		<meta name="twitter:title" content={pageTitle} />
		<meta name="twitter:description" content={metaDescription} />
		<meta name="twitter:image" content={ogImage} />
		<script type="application/ld+json" set:html={JSON.stringify(jsonLd)}></script>
		{favicons.map(favicon => (
			<link rel="icon"
				  href={favicon.src.startsWith('/') ? makeUrl(favicon.src) : favicon.src}
				  sizes={favicon.sizes}
				  media={favicon.theme && `(prefers-color-scheme: ${favicon.theme})`}
			/>
		))}
		{(isPostPage || currentPath.startsWith('/about')) && <link rel="preload" href="/images/about-bg.webp" as="image" />}
		<script>
			import { PageLifecycle } from "../scripts/page-lifecycle";
			import { animateInMain, restoreContent, showSkeleton } from "../scripts/skeleton";
			import { setCurrentPath } from "../scripts/nav-state";
			import { initTheme } from "../scripts/theme";
			import { $isNavMenuOpen } from "../store/app";

			let drawerScrollY = 0;
			$isNavMenuOpen.subscribe((isOpen) => {
				const pw = document.getElementById('push-wrapper');
				if (isOpen) {
					drawerScrollY = window.scrollY;
					document.body.style.top = `-${drawerScrollY}px`;
					document.body.classList.add('drawer-open');
					if (pw) pw.style.willChange = 'transform';
				} else {
					document.body.classList.remove('drawer-open');
					document.body.style.top = '';
					if (pw) {
						const onEnd = () => { pw.style.willChange = 'auto'; pw.removeEventListener('transitionend', onEnd); };
						pw.addEventListener('transitionend', onEnd);
					}
					window.scrollTo({ top: drawerScrollY, behavior: 'instant' });
				}
			});

			let parallaxEls: HTMLElement[] = [];
			const refreshParallaxEls = () => {
				parallaxEls = Array.from(document.querySelectorAll<HTMLElement>('[data-parallax]'));
			};
			refreshParallaxEls();
			if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
				let ticking = false;
				window.addEventListener('scroll', () => {
					if (!ticking) {
						requestAnimationFrame(() => {
							for (const el of parallaxEls) {
								const rect = el.getBoundingClientRect();
								if (rect.bottom > 0 && rect.top < window.innerHeight) {
									const offset = window.scrollY * 0.15;
									el.style.transform = `translateY(${offset}px)`;
								}
							}
							ticking = false;
						});
						ticking = true;
					}
				}, { passive: true });
			}

			const onPageReady = () => {
				PageLifecycle.onPageLoad();
			};

			document.addEventListener('swup:visit:start', (event: CustomEvent) => {
				const detail = event.detail as { visit: { to: { url: string }; history?: { popstate?: boolean } } };
				setCurrentPath(detail.visit.to.url.split('?')[0].replace(/\/?$/, "/"));
				showSkeleton(detail.visit.history?.popstate === true);
			});
			document.addEventListener('swup:content:replace', () => {
				document.dispatchEvent(new CustomEvent('astro:after-swap'));
				refreshParallaxEls();
				animateInMain();
			});
			document.addEventListener('swup:visit:end', () => {
				requestAnimationFrame(() => onPageReady());
			});
			document.addEventListener('swup:visit:abort', () => {
				restoreContent();
			});

			initTheme();
			setCurrentPath(window.location.pathname.replace(/\/?$/, "/"));
			if (document.readyState === 'loading') {
				document.addEventListener('DOMContentLoaded', onPageReady, { once: true });
			} else {
				onPageReady();
			}
		</script>
        <style define:vars={{
			'banner-height': `${BANNER_HEIGHT}vh`,
			'banner-height-total': `${BANNER_HEIGHT + BANNER_HEIGHT_EXTEND}vh`,
			'page-width': `${PAGE_WIDTH}rem`,
			'overlap-height': `${MAIN_PANEL_OVERLAPS_BANNER_HEIGHT}rem`,
		}}></style>
		<noscript>
			<style is:inline>
				.scroll-reveal { opacity: 1 !important; filter: none !important; transform: none !important; }
			</style>
		</noscript>
		<slot name="head"></slot>
		</head>
		<body class:list={[{ "is-home": isHomePage }]}>
			<MobileNav siteTitle={siteName} locale={locale} switchHref={switchHref} switchLocale={switchLocale} />
			<div id="push-wrapper">
				<SideDrawer items={links.map(l => ({ label: l.name, href: l.url }))} siteTitle={siteName} locale={locale} switchHref={switchHref} switchLocale={switchLocale} />
				<div id="content-wrapper">
					<main id="content-main" class="transition-slide">
						<Lightbox></Lightbox>
						<div class="w-full flex flex-col toc:items-center flex-1">
							<div class="flex flex-col items-center gap-0 flex-1 w-full max-w-[840px] mx-auto">
								<div class="w-full pt-14 pb-0">
									<slot />
								</div>
								<div class:list={["w-full", !hideFooter && "mt-auto"]}>
									{!hideFooter && <Footer />}
								</div>
							</div>
						</div>
					</main>
				</div>
			</div>
			{featureConfig.analytics === "umami" && <Umami />}
			{featureConfig.search && <SearchPanel client:idle lang={locale} />}
		</body>
	</html>

<style is:global>
    html { scroll-behavior: smooth; }
    @media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } }
    body {
        overflow-x: hidden;
        background-color: var(--page-bg);
    }
    body.drawer-open {
        position: fixed;
        left: 0;
        right: 0;
        width: 100%;
        overflow: hidden;
        overscroll-behavior: none;
        touch-action: none;
    }
    body.drawer-open aside nav {
        touch-action: pan-y;
        overscroll-behavior: contain;
    }
    body.drawer-open .mobile-nav {
        opacity: 0;
        pointer-events: none;
    }
    body:not(.drawer-open) .drawer-overlay {
        opacity: 0;
        pointer-events: none;
    }
    body.drawer-open .drawer-overlay {
        opacity: 1;
    }
    body.drawer-open .mobile-toc-dropdown {
        opacity: 0;
        pointer-events: none;
    }
    #push-wrapper {
        display: flex;
        width: calc(100vw + 300px);
        transform: translateX(-300px);
        transition: transform 0.5s cubic-bezier(0.32, 0.72, 0, 1);
        min-height: 100vh;
    }
    #content-wrapper {
        width: 100vw;
        flex-shrink: 0;
        position: relative;
        min-height: 100vh;
    }
    #content-main {
        position: relative;
        min-height: 100vh;
        background-color: var(--page-bg);
        display: flex;
        flex-direction: column;
    }
    body.drawer-open #push-wrapper {
        will-change: transform;
        transform: translateX(0);
    }
    /* Desktop */
    @media (min-width: 1140px) {
        #push-wrapper {
            transform: none !important;
            width: 100vw;
            transition: none !important;
        }
        #push-wrapper > aside {
            position: fixed;
            left: 0;
            top: 0;
            height: 100vh;
        }
        #content-wrapper {
            width: calc(100vw - 300px);
            margin-left: 300px;
        }
        #push-wrapper nav.fixed {
            display: none !important;
        }
    }
</style>
