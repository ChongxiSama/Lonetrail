const iconMap: Record<string, string> = {
	github: "github",
	telegram: "telegram",
	steam: "steam",
	bilibili: "bilibili",
	orcid: "orcid",
	email: "email",
	"material-symbols:home-outline": "home",
	"material-symbols:rss-feed": "rss",
	"material-symbols:mail-outline-rounded": "email",
	"fa6-brands:github": "github",
	"fa6-brands:telegram": "telegram",
	"fa6-brands:steam": "steam",
	"fa6-brands:bilibili": "bilibili",
	"fa6-brands:orcid": "orcid",
};

function getIconPath(icon: string): string | null {
	const key = iconMap[icon] || icon;
	return iconPaths[key] || null;
}
---

<div class:list={[
	"relative w-full max-w-[840px] bg-page paper-texture shadow-2xl px-6 md:px-16 py-10 overflow-hidden",
	className,
]}>
	<div class="absolute -top-10 -right-20 pointer-events-none select-none z-0">
		<span class="font-deco text-[150px] md:text-[240px] text-primary opacity-[0.03] leading-none uppercase whitespace-nowrap">
			Pioneer
		</span>
	</div>

	<div class="relative z-10 flex flex-col gap-4">
		{/* 第一行：头像 + 身份信息 */}
		<div class="flex items-center gap-4">
			<div class="relative w-16 h-16 md:w-20 md:h-20 bg-card border border-border/50 shrink-0 overflow-hidden">
				{avatarSrc ? (
					<img
						src={avatarSrc}
						alt={name}
						width="160"
						height="160"
						loading="lazy"
						decoding="async"
						class="w-full h-full object-cover block no-styling"
					/>
				) : (
					<div class="w-full h-full flex items-center justify-center">
						<span class="font-deco text-2xl text-secondary/20">CX</span>
					</div>
				)}
			</div>

			<div class="flex-1 min-w-0">
				<div class="flex items-start gap-2 mb-1">
					<div class="font-display text-2xl md:text-3xl text-primary uppercase tracking-tighter leading-none m-0 p-0">
						{name}
					</div>
				</div>
				{bio && (
					<p class="font-cn text-[12px] text-secondary leading-relaxed mb-1.5">
						{bio}
					</p>
				)}
				{tags.length > 0 && (
					<div class="flex flex-wrap items-center gap-2.5">
						{tags.map((tag, index) => (
							<Fragment>
								{index > 0 && <span class="h-2.5 w-px bg-border/60" />}
								<span class="font-deco text-[9px] font-bold uppercase tracking-[0.2em] text-secondary">
									{tag}
								</span>
							</Fragment>
						))}
					</div>
				)}
			</div>
		</div>

		{/* 第三行：链接 */}
		<div class="border-t border-border/20 pt-3 flex items-center gap-2">
			<div class="flex items-center gap-1">
				{links.filter(l => l.name !== "Home").map((link) => {
					const path = getIconPath(link.icon);
					return path ? (
						<a
							href={link.url}
							target="_blank"
							rel="noopener noreferrer"
							class="w-7 h-7 highlight-sweep flex items-center justify-center border border-primary/30 text-primary/60 hover:bg-hero hover:text-on-hero hover:border-primary transition-all active:scale-95"
							title={link.name}
						>
							<svg viewBox="0 0 24 24" class="w-3.5 h-3.5 fill-current"><path d={path}></path></svg>
						</a>
					) : null;
				})}
			</div>

		</div>
	</div>

	<StripeFooter />
</div>
