---
import { siteConfig } from "../../config";
import I18nKey from "../../i18n/i18nKey";
import { DEFAULT_LOCALE, type Locale } from "../../i18n/locales";
import { i18n } from "../../i18n/translation";
import { StripeFooter } from "../ui/StripeFooter.tsx";

interface Props {
	title: string;
	count: number;
	variant?: "dark" | "light";
	compact?: boolean;
	lang?: Locale;
}

const {
	title = "归档",
	count = 0,
	variant = "dark",
	compact = false,
	lang = DEFAULT_LOCALE,
} = Astro.props;
const t = (key: I18nKey) => i18n(key, lang);
const isDark = variant === "dark";
---
{isDark ? (
    <div class="w-full max-w-[840px]" style="filter: drop-shadow(0 8px 30px rgba(0,0,0,0.3));">
    <div class:list={["relative px-6 md:px-10 overflow-hidden group", compact ? "py-6 md:py-7" : "py-8 md:py-10"]}>
        <img src="/images/backend.webp" alt="" class="absolute inset-0 w-full h-full object-cover z-0" loading="eager" decoding="async" />
        <div class="absolute inset-0 bg-black/60 z-[1]"></div>
        <div class="absolute -top-1 -left-1 w-3 h-3 border-t border-l border-on-hero/40 z-20"></div>
        <div class="absolute -top-1 -right-1 w-3 h-3 border-t border-r border-on-hero/40 z-20"></div>
        <div class="absolute -bottom-1 -left-1 w-3 h-3 border-b border-l border-on-hero/40 z-20"></div>
        <div class="absolute -bottom-1 -right-1 w-3 h-3 border-b border-r border-on-hero/40 z-20"></div>

        <div class="absolute inset-0 paper-texture opacity-30 pointer-events-none z-[2]"></div>

        <div class:list={["relative z-10 flex justify-between items-center", compact ? "mb-5" : "mb-10 md:mb-12"]}>
            <div class="flex items-center gap-3">
                <div class="w-[3px] h-[10px] bg-accent"></div>
                <span class="font-deco text-[10px] md:text-[11px] font-bold tracking-[0.2em] uppercase text-on-hero/70">
                    {siteConfig.title} // {t(I18nKey.archive)}
                </span>
            </div>
            <div class="hidden sm:block">
                <span class="font-deco text-[10px] md:text-[11px] uppercase tracking-widest text-on-hero/60">
                    {count} {t(I18nKey.recordsIndexed)}
                </span>
            </div>
        </div>

        <div class="relative z-10">
            <div class="absolute -top-4 md:-top-10 -right-8 md:-right-20 pointer-events-none select-none">
                <span class="font-deco text-[32px] md:text-[120px] text-on-hero opacity-[0.03] leading-none uppercase whitespace-nowrap">
                    AD ASTRA PER ASPERA
                </span>
            </div>

            <h1 class:list={[
                "font-heading leading-[1.1] tracking-tight text-on-hero font-black whitespace-nowrap flex uppercase",
                compact ? "text-[30px] md:text-[44px] mb-4" : "text-[38px] md:text-[64px] md:leading-[0.85] md:tracking-tighter mb-6",
            ]}>
                {title}
            </h1>

            <div class:list={["flex flex-col md:flex-row md:items-end justify-between gap-6 border-t border-on-hero/10", compact ? "pt-4" : "pt-6"]}>
                <p class="font-cn text-[11px] text-on-hero/40 tracking-[0.2em]">
                    {t(I18nKey.tagline)}
                </p>
            </div>
        </div>

        <StripeFooter />
    </div>
    </div>
) : (
    <div class="relative w-full max-w-[840px] bg-page paper-texture shadow-2xl px-6 md:px-16 py-10 overflow-hidden border-b border-border/10">
        <div class="relative z-10 flex justify-between items-end">
            <div class="space-y-1">
                <div class="flex items-center gap-2">
                    <div class="w-[3px] h-[10px] bg-accent"></div>
                    <span class="text-[11px] font-deco tracking-[0.2em] font-bold text-primary uppercase">
                        Chapter_Archive
                    </span>
                </div>
                <h1 class="font-heading text-4xl md:text-6xl tracking-tighter uppercase text-primary">
                    {title}
                </h1>
            </div>
            <div class="text-right hidden sm:block">
                <span class="text-[11px] font-deco text-secondary uppercase tracking-widest">
                    {count} {t(I18nKey.recordsIndexed)}
                </span>
            </div>
        </div>
        <div class="absolute bottom-0 left-0 right-0 h-[3px] flex opacity-30">
            <div class="bg-rl-teal w-1/3"></div>
            <div class="bg-rl-gold w-1/3"></div>
            <div class="bg-rl-red w-1/3"></div>
        </div>
    </div>
)}
