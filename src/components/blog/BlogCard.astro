---
import { DEFAULT_LOCALE, type Locale } from "../../i18n/locales";
import { getCategoryLabel, getTagLabel } from "../../i18n/taxonomy";

interface Props {
	title: string;
	summary: string;
	category: string;
	date: string;
	index: number;
	href: string;
	alt?: boolean;
	tags?: string[];
	minutes?: number;
	lang?: Locale;
}

const {
	title,
	summary,
	category,
	date,
	href,
	alt = false,
	tags = [],
	minutes,
	lang = DEFAULT_LOCALE,
} = Astro.props;

const categoryLabel = getCategoryLabel(category, lang);
const tagLabels = tags.map((tag) => getTagLabel(tag, lang));
---

<a
    href={href}
    class:list={[
        "group relative w-full max-w-[840px] paper-texture shadow-2xl px-6 md:px-10 py-6 overflow-hidden block hover:-translate-y-0.5 hover:shadow-xl hover:bg-accent/[0.04] transition-all duration-200 highlight-sweep",
        alt ? "bg-card" : "bg-page",
    ]}
>
    <div class="relative z-10">
        <div class="flex flex-wrap items-center gap-x-3 gap-y-1 mb-3">
            <span class="font-deco text-[10px] text-accent uppercase tracking-[0.25em]">
                {categoryLabel || "Technical Note"}
            </span>
            <span class="w-1 h-1 bg-hover/60 rounded-full"></span>
            <span class="font-date text-[11px] text-secondary tracking-[0.12em]">
                {date}
            </span>
            {minutes ? (
                <>
                    <span class="w-1 h-1 bg-hover/60 rounded-full"></span>
                    <span class="font-deco text-[10px] text-hint uppercase tracking-[0.2em]">
                        {minutes} min
                    </span>
                </>
            ) : null}
        </div>

        <h2 class="font-heading text-[22px] sm:text-[24px] leading-[1.25] tracking-tight text-primary uppercase group-hover:text-accent transition-colors font-black mb-3">
            {title}
        </h2>

        {summary && (
            <p class="font-cn text-[14px] text-hint leading-[1.75] line-clamp-2 mb-4">
                {summary}
            </p>
        )}

        {tags.length > 0 && (
            <div class="flex flex-wrap items-center gap-1.5">
                {tagLabels.slice(0, 4).map((tag) => (
                    <span class="px-1.5 py-0.5 text-[9px] font-deco border border-border/40 text-secondary uppercase tracking-widest">
                        #{tag}
                    </span>
                ))}
            </div>
        )}
    </div>

</a>
