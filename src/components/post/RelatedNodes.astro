---
interface Props {
	nodes: Array<{ title: string; href: string; category: string }>;
	nextPost?: { title: string; href: string; id: string };
}

const { nodes = [], nextPost } = Astro.props;

const statusMap: Record<string, { label: string; color: string }> = {
	技术: { label: "ACTIVE", color: "bg-rl-green" },
	日志: { label: "ARCHIVED", color: "bg-on-hero/30" },
	闲谈: { label: "PENDING", color: "bg-rl-gold" },
	博客: { label: "ACTIVE", color: "bg-rl-green" },
};
---
<div class="relative w-full max-w-[840px] bg-hero paper-texture shadow-2xl px-6 md:px-16 py-10 md:py-12 overflow-hidden">
    <div class="absolute -right-6 -bottom-8 opacity-[0.02] select-none pointer-events-none z-0">
        <span class="font-deco text-[150px] md:text-[240px] text-on-hero uppercase italic font-black leading-none">
            References
        </span>
    </div>

    <div class="relative z-10 flex items-center gap-2 mb-6">
        <div class="w-[3px] h-[10px] bg-accent"></div>
        <span class="text-[10px] font-deco tracking-[0.25em] font-bold text-on-hero/70 uppercase">
            Cross References
        </span>
        <div class="flex-1 h-px bg-white/10"></div>
    </div>

    <div class="relative z-10">
        {nodes.map((node, i) => {
            const status = statusMap[node.category] || { label: "ACTIVE", color: "bg-rl-green" };
            return (
                <a
                    href={node.href}
                    class="group relative flex items-start gap-4 py-3.5 pl-4 -ml-4 pr-2 border-b border-white/5 hover:bg-white/[0.03] transition-all duration-200 highlight-sweep"
                >
                    <div class="absolute left-0 top-1/2 -translate-y-1/2 w-[3px] h-0 group-hover:h-8 bg-accent transition-all duration-300 rounded-full"></div>
                    <span class="font-mono text-[12px] text-accent/50 group-hover:text-accent font-bold tracking-wider shrink-0 mt-0.5 transition-colors">
                        [{String(i + 1).padStart(2, "0")}]
                    </span>
                    <div class="flex-1 min-w-0">
                        <h4 class="font-heading text-[16px] text-on-hero/80 font-bold leading-[1.6] mb-1.5 group-hover:text-white transition-colors">
                            {node.title}
                        </h4>
                        <div class="flex items-center gap-2.5">
                            <span class:list={[
                                "w-1.5 h-1.5 rounded-full shrink-0",
                                status.color,
                            ]}></span>
                            {node.category && (
                                <span class="font-deco text-[9px] text-on-hero/40 uppercase tracking-widest">
                                    {node.category}
                                </span>
                            )}
                            <span class="font-deco text-[9px] text-on-hero/20 uppercase tracking-widest">
                                &middot;
                            </span>
                            <span class="font-mono text-[9px] text-on-hero/30 uppercase tracking-wider">
                                {status.label}
                            </span>
                        </div>
                    </div>
                    <span class="font-deco text-[12px] text-on-hero/10 group-hover:text-accent/70 transition-all duration-200 shrink-0 mt-1 group-hover:translate-x-1">
                        &rarr;
                    </span>
                </a>
            );
        })}
    </div>

    {nextPost && (
        <div class="relative z-10 mt-6 pt-6 border-t border-white/10">
            <a
                href={nextPost.href}
                class="group relative flex items-center justify-between py-3 -mx-2 px-2 hover:bg-white/[0.03] transition-all duration-200 highlight-sweep"
            >
                <div class="absolute left-0 top-1/2 -translate-y-1/2 w-[3px] h-0 group-hover:h-8 bg-accent transition-all duration-300 rounded-full"></div>
                <div class="flex items-center gap-4 min-w-0 pl-4">
                    <span class="font-deco text-lg text-accent/40 group-hover:text-accent shrink-0 transition-colors">
                        &rarr;
                    </span>
                    <div class="space-y-0.5 min-w-0">
                        <span class="block text-[9px] font-deco text-accent/40 uppercase tracking-widest leading-none">
                            Next Report
                        </span>
                        <h5 class="font-heading text-[14px] text-on-hero/70 font-bold truncate group-hover:text-white transition-colors">
                            {nextPost.title}
                        </h5>
                    </div>
                </div>
                <span class="hidden md:block font-mono text-[10px] text-accent/30 group-hover:text-accent/60 uppercase shrink-0 transition-colors">
                    {nextPost.id}
                </span>
            </a>
        </div>
    )}
</div>
