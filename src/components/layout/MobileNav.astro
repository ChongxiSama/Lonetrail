---
import { siteConfig } from "../../config";
import I18nKey from "../../i18n/i18nKey";
import type { Locale } from "../../i18n/locales";
import { i18n } from "../../i18n/translation";

interface Props {
	siteTitle?: string;
	locale: Locale;
	switchHref: string;
	switchLocale: Locale;
}

const { siteTitle = siteConfig.title, locale } = Astro.props;
const openNav = i18n(I18nKey.openNav, locale);
const versionTag = locale === "en" ? "EN.ver" : "CN.ver";
---

<nav class="mobile-nav fixed top-0 left-0 w-full h-14 flex items-center justify-between gap-4 px-4 sm:px-6 z-50 bg-page border-b border-border shadow-sm transition-all duration-300 ease-in-out min-[1140px]:hidden">
	<div class="flex min-w-0 items-center gap-3">
		<button
			data-action="open-nav"
			class="group flex h-[44px] w-[44px] shrink-0 items-center justify-center"
			title={openNav}
			aria-label={openNav}
		>
			<svg
				class="w-6 h-6 text-primary group-hover:text-accent transition-colors"
				viewBox="0 0 24 24"
				fill="none"
				stroke="currentColor"
				stroke-width="2"
			>
				<path
					stroke-linecap="round"
					stroke-linejoin="round"
					d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5"
				/>
			</svg>
		</button>
		<span class="h-4 w-px shrink-0 bg-border"></span>
		<span class="truncate font-display text-[12px] sm:text-[13px] tracking-tight uppercase text-primary"
			>{siteTitle}</span
		>
	</div>

	<span
		class="shrink-0 border border-border px-1.5 py-0.5 font-deco text-[9px] uppercase tracking-[0.2em] text-secondary"
		>{versionTag}</span
	>
</nav>

<script>
	import { openNav } from "../../scripts/nav-state";

	document.addEventListener("click", (e) => {
		const target = (e.target as HTMLElement).closest("[data-action]");
		if (!target) return;
		const action = (target as HTMLElement).dataset.action;
		if (action === "open-nav") openNav();
	});
</script>
