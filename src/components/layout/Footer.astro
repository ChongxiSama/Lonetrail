---
import { copyrightConfig, siteMeta } from "../../config";

const currentYear = new Date().getFullYear();
const startYear = 2025;
const licenseUrl = copyrightConfig.licenseUrl;
---
<div class="relative w-full max-w-[840px] bg-hero paper-texture shadow-2xl px-6 md:px-16 py-12 overflow-hidden">
    <!-- Background image -->
    <div class="absolute inset-0 z-0">
        <img
            src="/images/footer-bg.webp"
            alt=""
            width="840"
            height="473"
            loading="lazy"
            decoding="async"
            class="w-full h-full object-cover"
        />
        <div class="absolute inset-0 bg-black/70"></div>
    </div>

    <!-- Watermark -->
    <div class="absolute bottom-6 left-4 pointer-events-none select-none z-[3]">
        <span class="font-deco text-[100px] text-on-hero opacity-[0.03] leading-none uppercase whitespace-nowrap">Archive_Ref</span>
    </div>

    <!-- Corner decorations -->
    <div class="absolute z-10 -top-1 -left-1 w-3 h-3 border-t border-l border-on-hero/40"></div>
    <div class="absolute z-10 -top-1 -right-1 w-3 h-3 border-t border-r border-on-hero/40"></div>
    <div class="absolute z-10 -bottom-1 -left-1 w-3 h-3 border-b border-l border-on-hero/40"></div>
    <div class="absolute z-10 -bottom-1 -right-1 w-3 h-3 border-b border-r border-on-hero/40"></div>

    <!-- Paper texture overlay -->
    <div class="absolute inset-0 z-[2] paper-texture opacity-20 pointer-events-none"></div>

    <div class="relative z-10">
        <div class="text-sm text-right text-on-hero/60 font-display">
            Copyright &copy; {startYear}&ndash;{currentYear} <span class="text-accent">{copyrightConfig.siteName}</span><br />
            <span class="opacity-50">Powered by</span>{" "}
            <a class="transition link text-accent font-medium hover:underline" target="_blank" rel="noopener noreferrer" href="https://astro.build">Astro</a>{" "}
            <span class="opacity-50">&amp;</span>{" "}
            <a class="transition link text-accent font-medium hover:underline" target="_blank" rel="noopener noreferrer" href={siteMeta.url}>Lonetrail</a>
            {licenseUrl && (
                <>
                    <br />
                    <span class="opacity-50">Licensed under</span>{" "}
                    <a class="transition link text-accent font-medium hover:underline" target="_blank" rel="noopener noreferrer" href={licenseUrl}>{copyrightConfig.license}</a>
                </>
            )}
        </div>
    </div>
</div>
